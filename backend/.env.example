DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/matchguard

# Comma-separated frontend origins allowed by CORS (no "*"), e.g.
# CORS_ORIGINS=http://localhost:5173,https://example.vercel.app
CORS_ORIGINS=http://localhost:5173

# Rejection feedback extraction: "gemini" (default), "openai", or "demo" (local keyword
# rules, no key needed). Put real keys in .env, never in git.
FEEDBACK_EXTRACTOR=gemini

# Only needed when FEEDBACK_EXTRACTOR=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Only needed when FEEDBACK_EXTRACTOR=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
